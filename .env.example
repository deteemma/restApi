# Adresse d'écoute de l'API. Par défaut, uniquement en local.
HOST=127.0.0.1
PORT=3000

# Si défini, toute requête /api (sauf /api/health) doit fournir l'en-tête X-API-Key.
# API_KEY=

# Base MongoDB (conteneur docker compose).
MONGODB_URI=mongodb://127.0.0.1:27018/restapi

# Phrase de chiffrement des Variables secrètes. Obligatoire en production.
# En développement, si absente, une clé est générée dans .data/secret.key
# (ne perdez pas ce fichier : les secrets enregistrés deviendraient illisibles).
# SECRET_KEY=
